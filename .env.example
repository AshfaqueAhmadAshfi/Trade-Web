# Your public domain (no https:// and no trailing slash)
DOMAIN=example.com

# Optional: the email Let's Encrypt uses for expiry warnings
ACME_EMAIL=you@example.com

# Set your own dashboard password for domain/cPanel access. No default password.
SOFTRADEX_DASHBOARD_PASSWORD=
# Only list trusted reverse-proxy IPs here; direct clients are never trusted.
FORWARDED_ALLOW_IPS=
