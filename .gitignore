# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# SQLite Databases & WAL files
data/*.db
data/*.db-shm
data/*.db-wal
*.db
*.db-shm
*.db-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Local environment (DOMAIN etc.) - never commit
.env

