config/config.json
config/config.*.json.tmp
data/*.json
data/*.json.*.tmp
data/*.pid
link_check_tmp.py

# Freebuff / IDE / Logs
.freebuff/
.idea/
.vscode/
*.log
data/_*.json
data/*.log

# Private Python environment & build output
.venv/
dist/

# Archives & Backup bundles
*.rar
*.zip
*.tar.gz

# Temporary screenshot harnesses & captures
data/shot-*.png
web/_shot_*.html

# Generated artifacts and private chat imports
.cloud-attachments/
outputs/
verify/
